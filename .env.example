# === Telegram Bot ===
BOT_TOKEN=your_bot_token_from_botfather
OWNER_ID=123456789

# === Webhook (optional — derived automatically when missing) ===
# WEBHOOK_SECRET=custom_secret
# WEBHOOK_URL=https://your-domain.com/api/telegram/webhook

# === Server ===
PORT=3000
NODE_ENV=production

# === Session (Manus platform — omit for self-hosted) ===
# JWT_SECRET=random_32_char_string
# OWNER_OPEN_ID=
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# === Behaviour ===
TRUST_PROXY=1

# === Download throughput (scale) ===
# Maximum downloads running at the same time on the server (1–64, default 2).
# On free tiers (0.25 CPU / 256MB) keep 2 or less; each download runs a
# python (yt-dlp) + ffmpeg process that needs ~100-200MB.
# DOWNLOAD_MAX_CONCURRENT=2
# Maximum downloads queued while others finish (10–50000, default 1000).
# Even with thousands of users sending links at once, no download is lost:
# they wait in the FIFO queue and start automatically as slots free up.
# DOWNLOAD_MAX_WAITING=1000
# Runtime persistence folder for forced-subscription channels (subscribed lists).
# It is created automatically and never committed to git.
# DATA_DIR=/app/data

# === Local testing (no public HTTPS needed) ===
# Enables long polling via getUpdates instead of a webhook, for trying the bot locally.
# It removes any existing webhook when the server starts.
# TELEGRAM_POLLING=1
# Colored buttons already work without any of the values below.
# USE_CUSTOM_BUTTON_EMOJI=1 enables optional custom-emoji icons (needs Telegram Premium on the owner account).
# USE_CUSTOM_BUTTON_EMOJI=1
# BUTTON_CUSTOM_EMOJI_DOWNLOAD=5368324170671202286
# BUTTON_CUSTOM_EMOJI_AUDIO=5368324170671202286
# BUTTON_CUSTOM_EMOJI_IMAGE=5368324170671202286
# BUTTON_CUSTOM_EMOJI_CANCEL=5368324170671202286

# === Welcome photo ===
# The bot sends an attractive generated welcome banner with every /start.
# Set WELCOME_PHOTO_URL to a public image URL to use your own banner instead of the generated one.
# Set WELCOME_DISABLE_PHOTO=1 to send the welcome text without any photo.
# WELCOME_PHOTO_URL=https://example.com/banner.jpg
# WELCOME_DISABLE_PHOTO=1
