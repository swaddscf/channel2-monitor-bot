# Production environment for the free Oracle Cloud (or any VPS) deployment.
# Copy this file to .env on the server, fill the two secrets, and never commit it.

# === Required ===
BOT_TOKEN=your_bot_token_from_botfather
OWNER_ID=123456789

# === Runtime ===
NODE_ENV=production
PORT=3000

# === Local polling (no domain / no HTTPS needed) ===
# Keep this on the free VM. Delete it only if you switch to webhook mode.
TELEGRAM_POLLING=1

# === Webhook mode only (ignored while TELEGRAM_POLLING=1) ===
# TRUST_PROXY=1
# WEBHOOK_URL=https://your-domain.com/api/telegram/webhook
# WEBHOOK_SECRET=optional_custom_secret
